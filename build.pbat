{% set qtdir = "C:\\Qt\\4.8.7\\msvc" %}
{% set compiler = "msvc" %}
{% set arch = "x64" %}


def mysql
    {% if arch == "x64" %}
    {% set mysql_root = "C:\\mysql-8.2.0-winx64" %}
    if_exist_return(C:\mysql-8.2.0-winx64\bin\mysql.exe)
    download(https://cdn.mysql.com/Downloads/MySQL-8.2/mysql-8.2.0-winx64.zip, :cache, :v)
    unzip(mysql-8.2.0-winx64.zip, :o=C:\)
    {% else %}
    {% set mysql_root = "C:\\mysql-5.5.62-win32" %}
    if_exist_return(C:\mysql-5.5.62-win32\bin\mysql.exe)
    download(https://cdn.mysql.com/Downloads/MySQL-5.5/mysql-5.5.62-win32.zip, :cache, :v)
    unzip(mysql-5.5.62-win32.zip, :o=C:\)
    {% endif %}

def openssl
    if_exist_return(C:\OpenSSL\bin\openssl.exe)
    download(https://github.com/mugiseyebrows/drenor/releases/download/OpenSSL_1_0_1m/OpenSSL_1_0_1m.zip, :cache)
    unzip(OpenSSL_1_0_1m.zip, :o=C:\)

def main depends on mysql openssl
    github_checkout()
    move("C:\Program Files\OpenSSL", "C:\Program Files\OpenSSL_", :t)
    # move /y "C:\mingw64" "C:\mingw64_"
    # add_path(C:\mingw540_32\bin)
    add_path({{qtdir}}\bin)
    add_path({{mysql_root}}\lib)
    add_path({{mysql_root}}\bin)
    # add_path(C:\OpenSSL\bin)
    add_path(C:\Strawberry\perl\bin)
    use(conda)
    install(mugideploy)

    #PERL = find_app([C:\Strawberry\perl\bin\perl.exe])
    #MINGW = find_app([%CD%\mingw32\bin\gcc.exe])
    
    # https://download.qt.io/archive/qt/4.7/qt-everywhere-opensource-src-4.7.4.zip

    download(https://download.qt.io/archive/qt/4.8/4.8.7/qt-everywhere-opensource-src-4.8.7.zip, :cache)
    
    unzip(qt-everywhere-opensource-src-4.8.7.zip, :t=qt-everywhere-opensource-src-4.8.7)

    #download(https://github.com/mugiseyebrows/build-openssl/releases/download/1.1.1n/OpenSSL-1.1.1n-i686.zip, OpenSSL-1.1.1n-i686.zip)
    #unzip(OpenSSL-1.1.1n-i686.zip, OpenSSL)

    set OPENSSL_BIN=C:\OpenSSL\bin
    set OPENSSL_INCLUDE=C:\OpenSSL\include
    set OPENSSL_MODE=-openssl-linked 
    set OPENSSL_LIBS="-lssleay32 -llibeay32"
    
    set exclude=-no-declarative -no-multimedia  -no-accessibility -no-qt3support -no-xmlpatterns -no-webkit -no-scripttools -no-script -no-phonon -nomake tests -nomake examples -nomake demos -nomake tools

    pushd qt-everywhere-opensource-src-4.8.7
        #patch(..\0001-include-winerror.h.patch, :N, :p=1)
        patch(..\0001-fix-doc-script.patch, :N, :p1)
        #patch(..\0001-add-mysql-to-LIBS.patch, :N, :p1)
        patch(..\0001-link-libmysql.patch, :N, :p1)
        patch(..\0001-typedef-my_bool.patch, :N, :p1)

        #patch(..\0001-profile-flag.patch, :N, :p1)
        #patch(..\0001-uic3fix.patch, :N, :p1)
        #patch(..\0001-mysql-driver.patch, :N, :p1)
        #patch(..\0001-pg-flag-in-specs.patch, :N, :p1)
        # mingw32-make confclean
        # -developer-build
        # -I %OPENSSL_INCLUDE% -L %OPENSSL_BIN% -openssl-linked OPENSSL_LIBS="-lssleay32 -llibeay32"

        {% if compiler == "msvc" %}
        {% set platform = "win32-msvc2015" %}
        {% else %}
        {% set platform = "win32-g++" %}
        {% endif %}

        configure -prefix {{qtdir}} -opensource -developer-build -confirm-license -shared -platform {{ platform }} -opengl desktop -debug %exclude% -plugin-sql-mysql -plugin-sql-odbc -I {{mysql_root}}\include -L {{mysql_root}}\lib
        
        {% set targets1 = ["tools-bootstrap", "moc", "rcc", "uic", "winmain", "corelib", "xml", "network", "sql", "testlib", "gui", "qt3support", "uic3", "idc", "activeqt", "opengl", "phonon", "svg", "plugins", "tools", "translations", "demos"] %}
        {% set targets = ["tools-bootstrap", "moc", "rcc", "uic", "winmain", "corelib", "xml", "network", "sql", "testlib", "gui", "idc", "activeqt", "svg"] %}
        {% set targets = [] %}

        {% for target in targets %}
        mingw32-make -j4 sub-{{target}}-all-ordered || exit /b
        {% endfor %}

        # mkdir(bin\sqldrivers)
        # copy(plugins\sqldrivers\qsqlite4.dll, bin\sqldrivers)
        # mingw32-make docs

        # sub-moc-install_subtargets-ordered
        {% for target in targets %}
        mingw32-make -j4 sub-{{target}}-install_subtargets-ordered || exit /b
        {% endfor %}

        # mingw32-make install_qmake 
        # mingw32-make install_mkspecs
        # mingw32-make -j4 || exit /b
        # mingw32-make -j4 install || exit /b

        {% if compiler == "msvc" %}
        nmake || exit /b
        nmake install || exit /b
        {% else %}
        mingw32-make -j4 || exit /b
        mingw32-make -j4 install || exit /b
        {% endif %}

    popd
    # mugideploy copy-dep --bin {{qtdir}}\bin\qmake.exe --dst {{qtdir}}\bin
    # mugideploy copy-dep --bin {{qtdir}}\bin\QtNetwork4.dll --dst {{qtdir}}\bin
    # mugideploy copy-dep --bin {{qtdir}}\plugins\sqldrivers\qsqlmysql4.dll --dst {{qtdir}}\bin
    
    zip(Qt-4.8.7.7z, {{qtdir}})
    github_upload(Qt-4.8.7.7z)
    github_release(Qt-4.8.7.7z)

github_workflow 1
github_image windows-2019
env-policy 1